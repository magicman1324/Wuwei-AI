# 无为AI 环境变量配置

# 应用
WUWEI_DEBUG=false
WUWEI_LOG_LEVEL=INFO

# 数据库
WUWEI_DATABASE_URL=sqlite:///./data/db/wuwei.db

# LLM 配置
WUWEI_LLM_PROVIDER=qwen
WUWEI_LLM_API_KEY=your-qwen-api-key
WUWEI_LLM_MODEL=qwen-max

# 科大讯飞 (方言 ASR/TTS)
WUWEI_IFLYTEK_APP_ID=your-app-id
WUWEI_IFLYTEK_API_KEY=your-api-key
WUWEI_IFLYTEK_API_SECRET=your-api-secret

# 阿里云语音 (备选 ASR)
WUWEI_ALIYUN_ACCESS_KEY=your-access-key
WUWEI_ALIYUN_ACCESS_SECRET=your-access-secret
WUWEI_ALIYUN_ASR_APP_KEY=your-asr-app-key

# 方言配置
WUWEI_DEFAULT_DIALECT=cmn
WUWEI_ENABLED_DIALECTS=["cmn","yue","cmn-sichuan"]

# TTS 默认参数 (适老化)
WUWEI_TTS_DEFAULT_SPEED=0.85
WUWEI_TTS_DEFAULT_VOLUME=1.2
